from typing import Any, Optional, Sequence

class InitCommand: ...
class InitState: ...
class ArmAction: ...
class MotorControlMode: ...
class EtherCAT_Motor_Index: ...

class SystemInitStatus:
    last_state: int
    current_state: int
    change_reason: int
    error_code: int
    state_changed_at_ns: int
    timestamp_ns: int
    def __init__(self) -> None: ...

class ControlModeStatus:
    last_state: int
    current_state: int
    state_changed_at_ns: int
    timestamp_ns: int
    def __init__(self) -> None: ...

class CommunicationBoardState:
    error_flag: list[int]
    timestamp_ns: int
    def __init__(self) -> None: ...

class LogLevel:
    TRACE: LogLevel
    DEBUG: LogLevel
    INFO: LogLevel
    WARN: LogLevel
    ERROR: LogLevel
    CRITICAL: LogLevel
    OFF: LogLevel

def init_logging() -> None: ...
def is_logging_initialized() -> bool: ...
def set_log_level(level: LogLevel) -> None: ...
def flush_log_on(level: LogLevel) -> None: ...
def log_trace(message: str) -> None: ...
def log_debug(message: str) -> None: ...
def log_info(message: str) -> None: ...
def log_warn(message: str) -> None: ...
def log_error(message: str) -> None: ...
def log_critical(message: str) -> None: ...
def log_event(message: str) -> None: ...

class Logger:
    def trace(self, message: str, *args: object) -> None: ...
    def debug(self, message: str, *args: object) -> None: ...
    def info(self, message: str, *args: object) -> None: ...
    def warning(self, message: str, *args: object) -> None: ...
    def warn(self, message: str, *args: object) -> None: ...
    def error(self, message: str, *args: object) -> None: ...
    def critical(self, message: str, *args: object) -> None: ...
    def fatal(self, message: str, *args: object) -> None: ...
    def event(self, message: str, *args: object) -> None: ...

logger: Logger

class Motor_Information:
    Position_Actual: float
    Speed_Actual: float
    Torque_Actual: float
    KP_Actual: float
    KD_Actual: float
    Error_flag: int
    def __init__(self) -> None: ...

class Motor_Control:
    Position: float
    Speed: float
    Torque: float
    KP: float
    KD: float
    def __init__(self) -> None: ...

class ArmPose:
    x: float
    y: float
    z: float
    roll: float
    pitch: float
    yaw: float
    def __init__(self) -> None: ...

class ArmEndPose:
    position: list[float]
    rotation: list[float]
    timestamp_ns: int
    def __init__(self) -> None: ...

class RobotInfo:
    robot_name: str
    robot_type: str
    firmware_version: str
    hardware_version: str
    software_version: str
    manufacturer: str
    timestamp_ns: int
    def __init__(self) -> None: ...

class HighLevelState:
    state: int
    progress: int
    timestamp_ns: int
    def __init__(self) -> None: ...

class ImuData:
    rpy: list[float]
    omega: list[float]
    accel: list[float]
    quat: list[float]
    error_flag: int
    timestamp_ns: int
    def __init__(self) -> None: ...

class XboxMap:
    a: bool
    b: bool
    x: bool
    y: bool
    rightShoulder: bool
    leftShoulder: bool
    leftStick: bool
    rightStick: bool
    start: bool
    back: bool
    dpadUp: bool
    dpadDown: bool
    dpadLeft: bool
    dpadRight: bool
    leftX: float
    leftY: float
    rightX: float
    rightY: float
    leftTrigger: float
    rightTrigger: float
    error_flag: int
    timestamp_ns: int
    def __init__(self) -> None: ...

class power_charge_state:
    status: int
    temperature: int
    soc: int
    def __init__(self) -> None: ...

class H1Robot:
    @staticmethod
    def get_instance(robot_ip: str = "127.0.0.1") -> H1Robot: ...
    def robot_connect(self) -> bool: ...
    def getControlPermission(self) -> bool: ...
    def releaseControlPermission(self) -> bool: ...
    def hasControlPermission(self) -> bool: ...
    def switchControlMode(self, new_mode: MotorControlMode) -> bool: ...
    def robot_init(self) -> bool: ...
    def robot_deinit(self) -> bool: ...
    def setMotorControl_low(self, motor_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setChassis_low(self, chassis_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setWaist_low(self, waist_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setHead_low(self, head_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setArm_low(self, arm_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setGripper_low(self, gripper_id: EtherCAT_Motor_Index, control: Motor_Control, is_hold_torque: bool = True) -> bool: ...
    def setFixedRod_low(self, is_open: int) -> bool: ...
    def setChassis_high(self, speed_x: float, speed_y: float) -> bool: ...
    def setWaist_high(self, action: ArmEndPose) -> bool: ...
    def setHead_high(self, head_id: EtherCAT_Motor_Index, control: Motor_Control) -> bool: ...
    def setArm_high(self, arm: ArmAction, action: ArmEndPose) -> bool: ...
    def setArmMove_high(self, arm: ArmAction, action: ArmEndPose, eef_velocity: float = 0.0,
                        eef_acceleration: float = 0.0, duration: float = 0.0,
                        block: bool = False) -> bool: ...
    def setGripper_high(self, gripper_id: EtherCAT_Motor_Index, control: Motor_Control, is_hold_torque: bool = True) -> bool: ...
    def setFixedRod_high(self, is_open: int) -> bool: ...
    def armPoseToArmEndPose(self, pose: ArmPose) -> ArmEndPose: ...
    def CreateCollectSession(self, config: str) -> bool: ...
    def Start(self) -> bool: ...
    def NextStep(self) -> bool: ...
    def Pause(self) -> bool: ...
    def Resume(self) -> bool: ...
    def Stop(self) -> bool: ...
    def Close(self) -> None: ...
    def getRobotInfo(self) -> tuple[bool, RobotInfo]: ...
    def getCommunicationBoardState(self) -> tuple[bool, CommunicationBoardState]: ...
    def getMotorState(self, motor_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getChassisState(self, chassis_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getChassisSpeedState(self) -> tuple[bool, Sequence[float], Sequence[float]]: ...
    def getWaistState(self, waist_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getHeadState(self, head_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getArmState(self, joint_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getHandRelative(self, arm: ArmAction) -> tuple[bool, ArmEndPose]: ...
    def getHeadRelative(self) -> tuple[bool, ArmEndPose]: ...
    def getHandCameraRelative(self, arm: ArmAction) -> tuple[bool, ArmEndPose]: ...
    def getHeadCameraRelative(self) -> tuple[bool, ArmEndPose]: ...
    def getGripperState(self, gripper_id: EtherCAT_Motor_Index) -> tuple[bool, Motor_Information]: ...
    def getGripperControlMode(self) -> tuple[bool, int]: ...
    def getFixedRodState(self) -> tuple[bool, int]: ...
    def getHighLevelState(self) -> tuple[bool, HighLevelState]: ...
    def getJoystickState(self) -> tuple[bool, XboxMap]: ...
    def getIMU_State(self) -> tuple[bool, ImuData]: ...
    def getPowerChargeState(self) -> tuple[bool, power_charge_state]: ...
    def getCurrentMode(self) -> MotorControlMode: ...
    def getControlModeStatus(self) -> ControlModeStatus: ...
    def getInitState(self) -> InitState: ...
    def getSystemInitStatus(self) -> SystemInitStatus: ...
    def isRobotConnected(self) -> bool: ...
    def startCameraDds(self) -> None: ...
    def stopCameraDds(self) -> None: ...
    def startCameraWebRTC(self) -> None: ...
    def stopCameraWebRTC(self) -> None: ...
    def getLatestCameraFrame(self, camera_name: str) -> Optional[tuple[Any, float]]: ...
    def getLatestCameraDepth(self, camera_name: str) -> Optional[tuple[Any, float]]: ...
    def getCameraState(self, camera_names: Sequence[str] = (), timeout_sec: float = 5.0) -> dict[str, Any]: ...
